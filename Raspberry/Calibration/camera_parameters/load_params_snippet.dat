def load_params():
    cmtx0 = np.array(
        [
            [1454.20093615, 0.00000000, 636.98582789],
            [0.00000000, 1430.80527442, 414.60984332],
            [0.00000000, 0.00000000, 1.00000000]
        ],
        dtype=np.float64,
    )
    dist0 = np.array(
        [
            [-0.31818120, 1.48671263, 0.00000000, 0.00000000, 0.00000000]
        ],
        dtype=np.float64,
    )
    cmtx1 = np.array(
        [
            [2701.47389141, 0.00000000, 635.84091941],
            [0.00000000, 2891.10786409, 378.89551762],
            [0.00000000, 0.00000000, 1.00000000]
        ],
        dtype=np.float64,
    )
    dist1 = np.array(
        [
            [-1.30445495, 14.24912745, 0.00000000, 0.00000000, 0.00000000]
        ],
        dtype=np.float64,
    )
    R_rel = np.array(
        [
            [0.99379690, -0.09401426, 0.05940574],
            [0.10801333, 0.94313855, -0.31436094],
            [-0.02647344, 0.31882753, 0.94744296]
        ],
        dtype=np.float64,
    )
    T_rel = np.array(
        [
            [-0.08041240],
            [1.18629406],
            [2.97309783]
        ],
        dtype=np.float64,
    )
    baseline_m = abs(float(T_rel[0][0]))
    if baseline_m > 2.0:
        T_rel = T_rel / 100.0
        baseline_m = abs(float(T_rel[0][0]))
    return cmtx0, dist0, cmtx1, dist1, R_rel, T_rel
